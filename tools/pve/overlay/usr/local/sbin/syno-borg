#!/bin/sh
# Daily borg backup of the Samba dataset from a ZFS snapshot mounted at a fixed path
# (the fixed path keeps borg's files cache valid between runs). Settings in
# /etc/syno-borg.env: BORG_REPO, BORG_RSH, SYNO_BORG_PREFIX, SYNO_BORG_DATASET.
# Prune and compact touch only the archives with this host's prefix. Another client may
# hold the repository lock (a shared repository), so every call waits up to 2 hours.
set -eu
. /etc/syno-borg.env
export BORG_REPO BORG_RSH
: "${SYNO_BORG_DATASET:=data/samba}" "${SYNO_BORG_PREFIX:=$(hostname -s)-}"
export BORG_RELOCATED_REPO_ACCESS_IS_OK=yes BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes
snap="$SYNO_BORG_DATASET@syno-borg"
mnt=/mnt/borg-samba
cleanup() { umount "$mnt" 2>/dev/null || true; zfs destroy "$snap" 2>/dev/null || true; }
# "syno-borg cleanup": ExecStopPost of the service (systemctl stop kills the whole cgroup,
# the EXIT trap below does not run then)
if [ "${1:-}" = cleanup ]; then cleanup; exit 0; fi
# the monitoring alerts on "syno-borg: fail rc=N" at once and on the age of "syno-borg: done"
on_exit() { rc=$?; cleanup; [ "$rc" -eq 0 ] || logger -t syno-borg "fail rc=$rc"; }
trap on_exit EXIT
cleanup
zfs snapshot "$snap"
mkdir -p "$mnt"
mount -t zfs -o ro "$snap" "$mnt"
logger -t syno-borg "start $snap"
# borg rc: 0 ok, 1 warning (e.g. a file changed while read; the archive is complete), >= 2 error
rc=0
borg create --lock-wait 7200 --stats --compression zstd --exclude-caches \
	--exclude 'sh:**/@eaDir' --exclude 'sh:**/#snapshot' \
	"::${SYNO_BORG_PREFIX}{now:%Y-%m-%dT%H:%M}" "$mnt" || rc=$?
[ "$rc" -le 1 ] || exit "$rc"
borg prune --lock-wait 7200 --glob-archives "${SYNO_BORG_PREFIX}*" --keep-daily 7 --keep-weekly 4 --keep-monthly 2
borg compact --lock-wait 7200
if [ "$rc" -eq 1 ]; then logger -t syno-borg "done (create warning rc=1)"; else logger -t syno-borg "done"; fi
